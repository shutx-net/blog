# Claude Code agent worktrees (checked out inside the repo)
.claude/worktrees/

# Nix / direnv
.direnv/
result
result-*

# Node
node_modules/
*.tsbuildinfo

# 記事の実体は private な shutx-net/blog-content にあり、デプロイ時にここへ
# checkout される。**追跡ファイルを 1 つも置かないこと** — .gitkeep も含めて。
# actions/checkout は path のディレクトリを自分で作るし、既定の clean が
# そこにあるものと衝突する。
site/src/content/posts/

# その checkout の降ろし先。**記事ディレクトリではない** — actions/checkout は
# リポジトリのルートを path に置くので、記事ディレクトリを直接指すと README.md が
# コレクションに混ざり、記事が 1 階層深くなって URL と RSS の guid が変わる。
content-repo/

# Astro
site/dist/
site/.astro/
admin/dist/
api/dist/

# CDK
infra/cdk.out/
infra/.cdk.staging/

# Local / personal
.env
.env.*
!.env.example
CLAUDE.local.md
.envrc.local
.DS_Store

# バンドルの書きかけ置き場（api/build.ts の stagingPathFor）。
# dist の中に置くと CDK の指紋計算と競合するため、1 つ上に逃がしている。
api/.build-staging/

# テストの一時置き場（api/test/support/scratch.ts）。
# os.tmpdir() に置くと github-token.test.ts の tmpdir スナップショットが落ちる。
.test-scratch/
