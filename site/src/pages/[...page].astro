---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";

import Layout from "../layouts/Layout.astro";
import {
  POSTS_PER_PAGE,
  byPubDateDesc,
  formatPubDate,
  isPublished,
  withTrailingSlash,
} from "../lib/posts.ts";
import { SITE_DESCRIPTION, SITE_NAME } from "../lib/site-meta.ts";

// This route owns '/' as well as '/2/'. A separate index.astro beside it makes
// astro warn `Could not render '' from route '/[...page]' as it conflicts with
// higher priority route '/'` and then exit 0 anyway, leaving '/' unpaginated with
// only '/2/' paginated -- and test/setup/build-site.ts runs at logLevel "error",
// so that warning is never printed.
export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection("posts", isPublished)).sort(byPubDateDesc);

  return paginate(posts, { pageSize: POSTS_PER_PAGE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout title={SITE_NAME} description={SITE_DESCRIPTION}>
  <h1>{SITE_NAME}</h1>
  <ul class="post-list">
    {
      page.data.map((post) => (
        <li class="post-list__item">
          {
            /* The date leads the entry for the same reason it leads the post page:
               it reads as a kicker above the title rather than a stray line under
               it. datetime carries the machine-readable form; the visible text is
               the JST date a Japanese reader expects. */
          }
          <p class="post-list__meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {formatPubDate(post.data.pubDate)}
            </time>
          </p>
          <a class="post-list__title" href={`/posts/${post.id}/`}>
            {post.data.title}
          </a>
          {
            /* description is required by postSchema. Printing it here is what makes
               that requirement pay for itself. */
          }
          <p class="post-list__summary">{post.data.description}</p>
          {
            /* Same chip styling as the post page, reached by class here because
               this list is free to carry one. The post page's own tag list cannot
               (the parity proof pins that element), so global.css declares the
               chip look once for both selectors. */
            post.data.tags.length > 0 && (
              <ul class="tag-list">
                {post.data.tags.map((tag) => (
                  <li>
                    <a href={`/tags/${tag}/`}>{tag}</a>
                  </li>
                ))}
              </ul>
            )
          }
        </li>
      ))
    }
  </ul>
  {
    /* page.url.prev/next are absent on the first and last page respectively, so
       both need guarding. They also arrive without a trailing slash ("/2", "/")
       while the emitted files are /2/index.html and the sitemap's loc values do
       carry one -- withTrailingSlash keeps both naming the same URL. Astro's
       paginate `format` option is not usable for this: it turns page 1's "/"
       into "//".

       The whole nav is dropped on a single-page site: "1 / 1" with no links is
       furniture that tells the reader nothing. */
    page.lastPage > 1 && (
      <nav class="pager" aria-label="ページ送り">
        {/* Rendered in all three cases so the position stays centred whether or
            not a link sits beside it -- an empty span holds the column. */}
        <span class="pager__edge">
          {page.url.prev && (
            <a rel="prev" href={withTrailingSlash(page.url.prev)}>
              前のページ
            </a>
          )}
        </span>
        <span class="pager__position">
          {page.currentPage} / {page.lastPage}
        </span>
        <span class="pager__edge pager__edge--next">
          {page.url.next && (
            <a rel="next" href={withTrailingSlash(page.url.next)}>
              次のページ
            </a>
          )}
        </span>
      </nav>
    )
  }
</Layout>
