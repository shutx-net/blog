---
import { getCollection } from "astro:content";

// `astro:content` is fine here: inside astro build the content data store
// resolves correctly. It is only unsafe to reach for from vitest, where the
// virtual module silently yields an empty Map.
// pubDate is normalised to a Date by the schema's z.coerce.date(), so valueOf()
// is safe to sort on.
const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>blog</title>
  </head>
  <body>
    <h1>blog</h1>
    <ul>
      {
        posts.map((post) => (
          <li>
            <a href={`/posts/${post.id}/`}>{post.data.title}</a>
          </li>
        ))
      }
    </ul>
  </body>
</html>
