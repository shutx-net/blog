---
import BaseHead from "../components/BaseHead.astro";
import "../styles/global.css";

// The single owner of the <html>/<head>/<body> boilerplate. Every page goes
// through here, which is what makes "does this page emit a canonical link?" a
// meaningful assertion in the build-layer tests.
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<html lang="ja">
  <head>
    <BaseHead title={title} description={description} noindex={noindex} />
  </head>
  <body>
    {
      /* Keyboard and screen-reader users otherwise tab through the site header on
         every page before reaching the content. Visually hidden until focused. */
    }
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header">
      <a class="site-header__name" href="/">blog</a>
    </header>
    <main id="main">
      <slot />
    </main>
    {
      /* Nothing derived from the current date here on purpose: a "© {this year}"
         would make two builds of the same commit differ across a year boundary,
         and dist/ is compared byte for byte when the deploy pipeline changes. */
    }
    <footer class="site-footer">
      <a href="/rss.xml">RSS</a>
    </footer>
  </body>
</html>
