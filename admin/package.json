{
  "name": "@blog/admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "POSTS_DIR=./test/fixtures/posts npm run build -w ../site && npm run build",
    "test": "POSTS_DIR=./test/fixtures/posts vitest run",
    "test:unit": "POSTS_DIR=./test/fixtures/posts vitest run --project unit",
    "test:watch": "POSTS_DIR=./test/fixtures/posts vitest --project unit",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.ts",
    "auth-smoke": "node scripts/auth-smoke.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4"
  },
  "devDependencies": {
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
